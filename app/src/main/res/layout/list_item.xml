<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView android:id="@+id/ivThumb"
        android:layout_width="56dp" android:layout_height="56dp"
        android:scaleType="centerCrop" android:visibility="gone"
        android:contentDescription="物品照片"
        android:background="#EEEEEE" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="12dp">
        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tvSub" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="#666666" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
